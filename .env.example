# Rivora — contoh variabel lingkungan. TIDAK berisi secret.
# Salin ke .env.local untuk pengembangan lokal. Jangan commit .env.local.
# Di Netlify, isi variabel lewat UI (Site configuration → Environment variables), bukan di repo.

# Sumber data: "fixture" (data demo, tanpa login) | "supabase" (login & database sungguhan)
RIVORA_DATA_SOURCE=fixture

# Skenario data demo: "lengkap" (Bu Sari, 6 kelas) | "kosong" (guru baru tanpa kelas)
RIVORA_DEMO_SCENARIO=lengkap

# Tanggal "hari ini" tetap untuk demo/screenshot (YYYY-MM-DD). Kosongkan = tanggal nyata Asia/Jakarta.
# Hanya berlaku saat RIVORA_DATA_SOURCE=fixture.
RIVORA_DEMO_TODAY=

# Izinkan data demo pada build production (next start / Netlify).
# HANYA untuk deploy preview. Jangan pernah "true" di production (PRD §8).
RIVORA_ALLOW_DEMO_DATA=false

# ---------------------------------------------------------------- Supabase (mode "supabase")
# Lokal: jalankan `npm run db:start`, lalu salin "API URL" dan "Publishable key" dari `supabase status`.
# Hosted: Project Settings → API. Hanya kunci PUBLISHABLE yang dipakai aplikasi.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------- Khusus test (jangan dipakai aplikasi)
# Test database terhadap Postgres Supabase lokal (`npm run test:db:supabase`).
# RIVORA_TEST_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Test integrasi Auth + RLS (`npm run test:integration`). Secret key lokal dari `supabase status`.
# Kunci rahasia TIDAK PERNAH diberi awalan NEXT_PUBLIC_ dan tidak dipakai di aplikasi.
# RIVORA_TEST_SUPABASE_URL=http://127.0.0.1:54321
# RIVORA_TEST_SUPABASE_PUBLISHABLE_KEY=
# RIVORA_TEST_SUPABASE_SECRET_KEY=
